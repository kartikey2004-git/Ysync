# Copy to .env (or export these directly) after `docker compose up -d`.
# Matches docker-compose.yml's default credentials/ports.

# apps/server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ysync
REDIS_URL=redis://localhost:6379
PORT=8080

# Better Auth
BETTER_AUTH_SECRET=<generate-a-random-secret-here>
BETTER_AUTH_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# apps/web
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
